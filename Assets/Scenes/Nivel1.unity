  camionTransform: {fileID: 1843540495}
  choferJugador: {fileID: 0}
  camaraPrincipal: {fileID: 1814803499}
  camaraJugadorScript: {fileID: 0}
  generadorCarretera: {fileID: 0}
  ambulanciaObjeto: {fileID: 937767545}
  sirenaAzul: {fileID: 659948430}
  sirenaRoja: {fileID: 279675291}
  velocidadAvance: 0.4
  puntoAccidente: 2.45
  multiplicadorRitmoConduccion: 0.7
  forzarNoche: 1
  materialCieloNoche: {fileID: 2100000, guid: c494c335823f54b52b2e87e1b7a63a23, type: 2}
  escenaNivel1: Nivel1_Bosque
  permitirSaltar: 1
  tiempoParaSaltar: 0.9
  lluviaNocturna: 1
  tituloJuego: EVITANDO EL FIN
  subtituloPrologo: "PR\xD3LOGO"
  textoLugar: "<size=120%><b>SIERRA DE GUANAJUATO</b></size>\n<color=#BBBBBB>Carretera a Dolores Hidalgo  \xB7  03:12 AM</color>"
  textoRadio: "<color=#8FD3FF><b>RADIO</b></color>  Unidad 7, \xBFc\xF3mo va la sierra? Ya se te hizo tarde.\n<color=#FFD98F><b>CHOFER</b></color>  Todo en orden, jefe. Ya casi llego a Dolores."
  textoFrenos: "<color=#FFD98F><b>CHOFER</b></color>\n<color=#FF4444><b>\xA1Los frenos no responden!</b></color>"
  textoMinutosDespues: "<size=90%><color=#BBBBBB>MINUTOS DESPU\xC9S</color></size>"
  textoParamedico1: "<color=#9FFFC8><b>PARAM\xC9DICO</b></color>  \xA1Aqu\xED est\xE1 el chofer! Pulso muy d\xE9bil, a la camilla, r\xE1pido."
  textoParamedico2: "<color=#9FFFC8><b>PARAM\xC9DICO</b></color>  <color=#FF5555><b>\xA1C\xF3digo rojo!</b></color> A urgencias, no tenemos mucho tiempo."
  textoCuerpo: "<size=115%>Tu cuerpo va camino a urgencias\u2026</size>"
  textoAlmaDespierta: "<size=130%><color=#66FFE0><b>Pero t\xFA sigues aqu\xED.</b></color></size>"
